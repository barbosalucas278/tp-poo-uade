  <diagram id="OSkraOtceN2LkwCg2N8F" name="Primeras modificaciones">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    %% ==========================================\n    %% 1. MODELO: ENTIDADES Y PERSONAJES\n    %% ==========================================\n    class EntidadCombate {\n        &lt;&lt;abstract&gt;&gt;\n        # String nombre\n        # int vidaActual\n        # int vidaMax\n        # int manaActual\n        # int manaMax\n        # int ataque\n        # int defensa\n        # int velocidad\n        + recibirDano(cantidad: int)\n        + curar(cantidad: int)\n        + estaVivo(): boolean\n    }\n\n    class Personaje {\n        &lt;&lt;abstract&gt;&gt;\n        # int nivel\n        # int experiencia\n        + ganarExperiencia(exp: int)\n        + subirNivel()\n        + realizarAccion(objetivo: EntidadCombate)*: int\n    }\n\n    class Enemigo {\n        &lt;&lt;abstract&gt;&gt;\n        # int recompensaExp\n        + seleccionarAccionIA(party: List~Personaje~): AccionCombate\n    }\n\n    EntidadCombate &lt;|-- Personaje\n    EntidadCombate &lt;|-- Enemigo\n\n    %% RAMA HECHIZERO\n    class Hechizero {\n        &lt;&lt;abstract&gt;&gt;\n        # int intelecto\n        + lanzarHechizo(objetivo: EntidadCombate): int\n    }\n    class Mago {\n        - int nivelDeArrogancia\n        + bolaDeFuego(objetivo: EntidadCombate): int\n    }\n    class Sacerdote {\n        - boolean sarcasmo\n        + curarHeridasLeves(objetivo: EntidadCombate): int\n    }\n    Personaje &lt;|-- Hechizero\n    Hechizero &lt;|-- Mago\n    Hechizero &lt;|-- Sacerdote\n\n    %% RAMA GUERRERO\n    class Guerrero {\n        &lt;&lt;abstract&gt;&gt;\n        # int fuerza\n        + atacarConArma(objetivo: EntidadCombate): int\n    }\n    class Tanque {\n        - String[] burla\n        + bloquear(dano: int): int\n    }\n    class Berserker {\n        - int furia\n        + lanzarArma(objetivo: EntidadCombate): int\n    }\n    Personaje &lt;|-- Guerrero\n    Guerrero &lt;|-- Tanque\n    Guerrero &lt;|-- Berserker\n\n    %% RAMA ASESINO\n    class Asesino {\n        &lt;&lt;abstract&gt;&gt;\n        # int destreza\n        + asesinar(objetivo: EntidadCombate): int\n    }\n    class Arquero {\n        - int concentracion\n        + posicionarse(x: int, y: int)\n    }\n    class Picaro {\n        - int avaricia\n        + mutilar(objetivo: EntidadCombate): int\n    }\n    Personaje &lt;|-- Asesino\n    Asesino &lt;|-- Arquero\n    Asesino &lt;|-- Picaro\n\n    %% ENEMIGOS CONCRETOS\n    class Trasgo {\n        + realizarAtaqueFisico()\n    }\n    class Brujo {\n        + lanzarHechizoOscuro()\n    }\n    Enemigo &lt;|-- Trasgo\n    Enemigo &lt;|-- Brujo\n\n    %% PATRON CREACIONAL\n    class PersonajeFactory {\n        &lt;&lt;utility&gt;&gt;\n        + crearPersonaje(tipo: String, nombre: String): Personaje\n    }\n    PersonajeFactory ..&gt; Personaje : &lt;&lt;create&gt;&gt;\n\n    %% ==========================================\n    %% 2. MODELO: INVENTARIO, ITEMS Y JUGADOR\n    %% ==========================================\n    class Jugador {\n        - String nombre\n        - party: List~Personaje~\n        - inventario: Inventario\n        + agregarPersonaje(p: Personaje)\n    }\n\n    class Inventario {\n        - items: List~Item~\n        + agregarItem(item: Item)\n        + usarItem(item: Item, objetivo: EntidadCombate)\n    }\n\n    class Item {\n        &lt;&lt;abstract&gt;&gt;\n        # String nombre\n        # String descripcion\n        + aplicarEfecto(objetivo: EntidadCombate)*\n    }\n\n    class ItemConsumible {\n        - int valorEfecto\n        - String tipoEfecto\n    }\n    class ItemEquipable {\n        - String statMejorada\n        - int bono\n    }\n\n    Item &lt;|-- ItemConsumible\n    Item &lt;|-- ItemEquipable\n    Jugador \&quot;1\&quot; *-- \&quot;1\&quot; Inventario\n    Jugador \&quot;1\&quot; *-- \&quot;2..4\&quot; Personaje : party\n    Inventario \&quot;1\&quot; o-- \&quot;*\&quot; Item\n\n    %% ==========================================\n    %% 3. MODELO: COMBATE\n    %% ==========================================\n    class Batalla {\n        - partyJugador: List~Personaje~\n        - enemigos: List~Enemigo~\n        - colaTurnos: Queue~EntidadCombate~\n        + calcularOrdenTurnos()\n        + siguienteTurno(): EntidadCombate\n        + procesarAccion(accion: String, origen: EntidadCombate, objetivo: EntidadCombate)\n        + verificarFinCombate(): boolean\n    }\n\n    Batalla \&quot;1\&quot; o-- \&quot;2..4\&quot; Personaje\n    Batalla \&quot;1\&quot; o-- \&quot;1..*\&quot; Enemigo\n\n    %% ==========================================\n    %% 4. CONTROLADORES, DTOs Y VISTA (MVC)\n    %% ==========================================\n    class GestorPartida {\n        &lt;&lt;Singleton&gt;&gt;\n        - instance: GestorPartida\n        - jugadorActual: Jugador\n        - batallaActual: Batalla\n        + getInstance(): GestorPartida\n        + guardarPartida(path: String)\n        + cargarPartida(path: String)\n    }\n\n    class PersonajeDTO {\n        &lt;&lt;Value Object&gt;&gt;\n        + String nombre\n        + int vidaActual\n        + int vidaMax\n        + int manaActual\n        + int nivel\n    }\n\n    class BatallaController {\n        + ejecutarAccionTurno(accion: String, targetId: int)\n        + obtenerEstadoCombateDTO(): PersonajeDTO\n    }\n\n    GestorPartida \&quot;1\&quot; --&gt; \&quot;1\&quot; Jugador\n    GestorPartida \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Batalla\n    BatallaController --&gt; GestorPartida\n    BatallaController ..&gt; PersonajeDTO : &lt;&lt;use&gt;&gt;\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="eDAASC47pTpprllEDtpS-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;EntidadCombate&lt;/b&gt;" mermaidId="n:EntidadCombate" mermaidBaseStyle="swimlane;html=1;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;horizontal=1;childLayout=stackLayout;startSize=72;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginTop=12;marginBottom=12;stackSpacing=0;swimlaneFillColor=light-dark(#ECECFF,#1f2020);whiteSpace=wrap;spacingTop=24;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" mermaidBaseValue="&lt;b&gt;EntidadCombate&lt;/b&gt;" id="eDAASC47pTpprllEDtpS-2">

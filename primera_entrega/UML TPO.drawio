  <diagram name="Base del diagrama" id="xwyGj2VJ3wkGQmD3hkwE">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="LHkcQDPwB_v6pwVyjTv7-0" />
        <mxCell id="LHkcQDPwB_v6pwVyjTv7-1" parent="LHkcQDPwB_v6pwVyjTv7-0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    %% ==========================================\n    %% 1. CAPA MODELO: ENTIDADES BASE\n    %% ==========================================\n    class EntidadCombate {\n        &lt;&lt;abstract&gt;&gt;\n        # String nombre\n        # int vidaActual\n        # int vidaMax\n        # int manaActual\n        # int manaMax\n        # int ataque\n        # int defensa\n        # int velocidad\n        + recibirDano(cantidad: int)\n        + curar(cantidad: int)\n        + estaVivo(): boolean\n    }\n\n    class Personaje {\n        &lt;&lt;abstract&gt;&gt;\n        # int nivel\n        # int experiencia\n        + ganarExperiencia(exp: int)\n        + subirNivel()\n        + realizarAccion(objetivo: EntidadCombate)*: int\n    }\n\n    class Enemigo {\n        &lt;&lt;abstract&gt;&gt;\n        # int recompensaExpBase\n        + seleccionarAccionIA(partyJugador: List~Personaje~)*: AccionCombate\n    }\n\n    EntidadCombate &lt;|-- Personaje\n    EntidadCombate &lt;|-- Enemigo\n\n    %% ==========================================\n    %% 2. JERARQUÍA DE PERSONAJES\n    %% ==========================================\n    class Hechizero {\n        &lt;&lt;abstract&gt;&gt;\n        # int intelecto\n        + lanzarHechizo(objetivo: EntidadCombate): int\n    }\n    class Mago {\n        - int nivelDeArrogancia\n        + bolaDeFuego(objetivo: EntidadCombate): int\n    }\n    class Sacerdote {\n        - boolean sarcasmo\n        + curarHeridasLeves(objetivo: EntidadCombate): int\n    }\n    Personaje &lt;|-- Hechizero\n    Hechizero &lt;|-- Mago\n    Hechizero &lt;|-- Sacerdote\n\n    class Guerrero {\n        &lt;&lt;abstract&gt;&gt;\n        # int fuerza\n        + atacarConArma(objetivo: EntidadCombate): int\n    }\n    class Tanque {\n        - String[] burla\n        + bloquear(dano: int): int\n    }\n    class Berserker {\n        - int furia\n        + lanzarArma(objetivo: EntidadCombate): int\n    }\n    Personaje &lt;|-- Guerrero\n    Guerrero &lt;|-- Tanque\n    Guerrero &lt;|-- Berserker\n\n    class Asesino {\n        &lt;&lt;abstract&gt;&gt;\n        # int destreza\n        + asesinar(objetivo: EntidadCombate): int\n    }\n    class Arquero {\n        - int concentracion\n        + posicionarse(x: int, y: int)\n    }\n    class Picaro {\n        - int avaricia\n        + mutilar(objetivo: EntidadCombate): int\n    }\n    Personaje &lt;|-- Asesino\n    Asesino &lt;|-- Arquero\n    Asesino &lt;|-- Picaro\n\n    %% ==========================================\n    %% 3. JERARQUÍA DE ENEMIGOS (POR PODER)\n    %% ==========================================\n    class Jefe {\n        - int multiplicadorFuria\n        + ejecutarAtaqueJefe()\n        + seleccionarAccionIA(partyJugador: List~Personaje~): AccionCombate\n    }\n    class Elite {\n        - String habilidadEspecial\n        + seleccionarAccionIA(partyJugador: List~Personaje~): AccionCombate\n    }\n    class Estandar {\n        + seleccionarAccionIA(partyJugador: List~Personaje~): AccionCombate\n    }\n    class Minion {\n        + seleccionarAccionIA(partyJugador: List~Personaje~): AccionCombate\n    }\n\n    Enemigo &lt;|-- Jefe\n    Enemigo &lt;|-- Elite\n    Enemigo &lt;|-- Estandar\n    Enemigo &lt;|-- Minion\n\n    %% ==========================================\n    %% 4. PATRONES CREACIONALES (FACTORIES)\n    %% ==========================================\n    class PersonajeFactory {\n        &lt;&lt;utility&gt;&gt;\n        + crearPersonaje(tipo: String, nombre: String): Personaje\n    }\n    class EnemigoFactory {\n        &lt;&lt;utility&gt;&gt;\n        + crearEnemigo(jerarquia: String, nombre: String): Enemigo\n    }\n\n    PersonajeFactory ..&gt; Personaje : &lt;&lt;create&gt;&gt;\n    EnemigoFactory ..&gt; Enemigo : &lt;&lt;create&gt;&gt;\n\n    %% ==========================================\n    %% 5. INVENTARIO, ITEMS Y JUGADOR\n    %% ==========================================\n    class Jugador {\n        - String nombre\n        - party: List~Personaje~\n        - inventario: Inventario\n        + agregarPersonaje(p: Personaje)\n    }\n\n    class Inventario {\n        - items: List~Item~\n        + agregarItem(item: Item)\n        + usarItem(item: Item, objetivo: EntidadCombate)\n    }\n\n    class Item {\n        &lt;&lt;abstract&gt;&gt;\n        # String nombre\n        # String descripcion\n        + aplicarEfecto(objetivo: EntidadCombate)*\n    }\n\n    class ItemConsumible {\n        - int valorEfecto\n        - String tipoEfecto\n    }\n    class ItemEquipable {\n        - String statMejorada\n        - int bono\n    }\n\n    Item &lt;|-- ItemConsumible\n    Item &lt;|-- ItemEquipable\n    Jugador \&quot;1\&quot; *-- \&quot;1\&quot; Inventario\n    Jugador \&quot;1\&quot; *-- \&quot;2..4\&quot; Personaje : party\n    Inventario \&quot;1\&quot; o-- \&quot;*\&quot; Item\n\n    %% ==========================================\n    %% 6. MOTOR DE COMBATE\n    %% ==========================================\n    class Batalla {\n        - partyJugador: List~Personaje~\n        - enemigos: List~Enemigo~\n        - colaTurnos: Queue~EntidadCombate~\n        + calcularOrdenTurnos()\n        + siguienteTurno(): EntidadCombate\n        + procesarAccion(accion: String, origen: EntidadCombate, objetivo: EntidadCombate)\n        + verificarFinCombate(): boolean\n    }\n\n    Batalla \&quot;1\&quot; o-- \&quot;2..4\&quot; Personaje\n    Batalla \&quot;1\&quot; o-- \&quot;1..*\&quot; Enemigo\n\n    %% ==========================================\n    %% 7. CONTROLADORES, DTOs, PERSISTENCIA Y VISTA\n    %% ==========================================\n    class GestorPartida {\n        &lt;&lt;Singleton&gt;&gt;\n        - instance: GestorPartida\n        - jugadorActual: Jugador\n        - batallaActual: Batalla\n        + getInstance(): GestorPartida\n        + guardarPartida(path: String)\n        + cargarPartida(path: String)\n    }\n\n    class GestorArchivos {\n        + guardar(jugador: Jugador, path: String)\n        + cargar(path: String): Jugador\n    }\n\n    class PersonajeDTO {\n        &lt;&lt;Value Object&gt;&gt;\n        + String nombre\n        + int vidaActual\n        + int vidaMax\n        + int manaActual\n        + int nivel\n    }\n\n    class BatallaController {\n        + ejecutarAccionTurno(accion: String, targetId: int)\n        + obtenerEstadoCombateDTO(): PersonajeDTO\n    }\n\n    GestorPartida \&quot;1\&quot; --&gt; \&quot;1\&quot; Jugador\n    GestorPartida \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Batalla\n    GestorPartida --&gt; GestorArchivos\n    BatallaController --&gt; GestorPartida\n    BatallaController ..&gt; PersonajeDTO : &lt;&lt;use&gt;&gt;\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="LHkcQDPwB_v6pwVyjTv7-2">
          <mxCell connectable="0" parent="LHkcQDPwB_v6pwVyjTv7-1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry height="1550" width="7720" as="geometry" />
          </mxCell>
        </UserObject>

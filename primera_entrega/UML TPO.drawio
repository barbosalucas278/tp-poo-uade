<mxfile host="app.diagrams.net" pages="3">
  <diagram id="zIxRlcqLcpy7EDHyXJNL" name="DIAGRAMA TPO - FINAL">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    %% PAQUETE: ENTIDADES BASE\n    class EntidadCombate {\n        &lt;&lt;abstract&gt;&gt;\n        # String nombre\n        # int vidaMax\n        # int vidaActual\n        # int manaMax\n        # int manaActual\n        # int ataqueBase\n        # int defensaBase\n        # int velocidad\n        # boolean estaDefendiendose\n        + recibirDano(cantidad: int) void\n        + curar(cantidad: int) void\n        + consumirMana(cantidad: int) void\n        + regenerarMana(cantidad: int) void\n        + estaVivo() boolean\n    }\n\n    class Personaje {\n        &lt;&lt;abstract&gt;&gt;\n        # int nivel\n        # int experienciaActual\n        # int experienciaSiguienteNivel\n        # String rutaImagen\n        # ItemEquipable armaEquipada\n        # ItemEquipable armaduraEquipada\n        + ganarExperiencia(exp: int) void\n        # subirDeNivel() void\n        + equiparArma(arma: ItemEquipable) void\n        + desequiparArma() ItemEquipable\n        + equiparArmadura(armadura: ItemEquipable) void\n        + desequiparArmadura() ItemEquipable\n        + usarHabilidadEspecial(objetivo: EntidadCombate)* void\n    }\n\n    class Jugador {\n        - String nombre\n        - int oro\n        - List~Personaje~ party\n        - Inventario inventarioGlobal\n        + agregarPersonaje(p: Personaje) void\n        + removerPersonaje(p: Personaje) void\n        + usarConsumible(item: ItemConsumible, objetivo: EntidadCombate) void\n        + getInventario() Inventario\n        + getParty() List~Personaje~\n    }\n\n    %% PAQUETE: INVENTARIO E ITEMS\n    class Inventario {\n        - List~Item~ items\n        - int capacidadMax\n        + agregarItem(item: Item) boolean\n        + removerItem(item: Item) boolean\n        + getItems() List~Item~\n    }\n\n    class Item {\n        &lt;&lt;abstract&gt;&gt;\n        # String nombre\n        # String descripcion\n    }\n\n    class ItemEquipable {\n        - int bonoAtaque\n        - int bonoDefensa\n        - String tipoSlot\n        + aplicarBono(entidad: EntidadCombate) void\n        + removerBono(entidad: EntidadCombate) void\n    }\n\n    class ItemConsumible {\n        &lt;&lt;abstract&gt;&gt;\n        + aplicarEfecto(objetivo: EntidadCombate)* void\n    }\n\n    %% JERARQUÍA DE POCIONES DE VIDA (Chica, Mediana, Grande)\n    class PocionVida {\n        &lt;&lt;abstract&gt;&gt;\n        # int curacion\n        + aplicarEfecto(objetivo: EntidadCombate) void\n    }\n\n    class PocionVidaChica {\n        + PocionVidaChica()\n    }\n\n    class PocionVidaMediana {\n        + PocionVidaMediana()\n    }\n\n    class PocionVidaGrande {\n        + PocionVidaGrande()\n    }\n\n    %% JERARQUÍA DE POCIONES DE MANÁ (Chica, Mediana, Grande)\n    class PocionMana {\n        &lt;&lt;abstract&gt;&gt;\n        # int manaRestaurado\n        + aplicarEfecto(objetivo: EntidadCombate) void\n    }\n\n    class PocionManaChica {\n        + PocionManaChica()\n    }\n\n    class PocionManaMediana {\n        + PocionManaMediana()\n    }\n\n    class PocionManaGrande {\n        + PocionManaGrande()\n    }\n\n    %% PAQUETE: CLASES Y ROLES\n    class Guerrero {\n        &lt;&lt;abstract&gt;&gt;\n        # int furia\n        + generarFuria(cantidad: int) void\n    }\n\n    class Hechicero {\n        &lt;&lt;abstract&gt;&gt;\n        # int poderMagico\n        + meditar() void\n    }\n\n    class Asesino {\n        &lt;&lt;abstract&gt;&gt;\n        # double probabilidadCritico\n        + sigilo() void\n    }\n\n    class Tanque {\n        + provocacion(objetivo: EntidadCombate) void\n        + usarHabilidadEspecial(objetivo: EntidadCombate) void\n    }\n\n    class Berserker {\n        + golpecritico(objetivo: EntidadCombate) void\n        + usarHabilidadEspecial(objetivo: EntidadCombate) void\n    }\n\n    class Mago {\n        + bolaDeFuego(objetivo: EntidadCombate) void\n        + usarHabilidadEspecial(objetivo: EntidadCombate) void\n    }\n\n    class Sacerdote {\n        + plegariaSustento(objetivo: EntidadCombate) void\n        + usarHabilidadEspecial(objetivo: EntidadCombate) void\n    }\n\n    class Arquero {\n        + disparoCertero(objetivo: EntidadCombate) void\n        + usarHabilidadEspecial(objetivo: EntidadCombate) void\n    }\n\n    class Picaro {\n        + estocadaSombra(objetivo: EntidadCombate) void\n        + usarHabilidadEspecial(objetivo: EntidadCombate) void\n    }\n\n    %% PAQUETE: ENEMIGOS\n    class Enemigo {\n        &lt;&lt;abstract&gt;&gt;\n        # int experienciaOtorgada\n        # int oroOtorgado\n        + seleccionarObjetivo(objetivosPosibles: List~EntidadCombate~) EntidadCombate\n        + ejecutarIA(objetivo: EntidadCombate)* void\n    }\n\n    class Jefe {\n        + faseFuria() void\n        + ejecutarIA(objetivo: EntidadCombate) void\n    }\n\n    class Elite {\n        + ejecutarIA(objetivo: EntidadCombate) void\n    }\n\n    class Estandar {\n        + ejecutarIA(objetivo: EntidadCombate) void\n    }\n\n    class Minion {\n        + ejecutarIA(objetivo: EntidadCombate) void\n    }\n\n    %% PAQUETE: CONTROLADORES Y PERSISTENCIA\n    class BatallaController {\n        - List~Personaje~ aliados\n        - List~Enemigo~ enemigos\n        - int turnoActual\n        + iniciarBatalla() void\n        + procesarTurno() void\n        + calcularOrdenIniciativa() List~EntidadCombate~\n        + verificarFinBatalla() boolean\n    }\n\n    class GestorArchivos {\n        + guardarPartida(jugador: Jugador, nombreArchivo: String)$ boolean\n        + cargarPartida(nombreArchivo: String)$ Jugador\n    }\n\n    class GestorPartida {\n        - GestorPartida instance$\n        - Jugador jugadorActual\n        - BatallaController batallaActiva\n        + getInstance()$ GestorPartida\n        + iniciarNuevoCombate(enemigos: List~Enemigo~) void\n        + guardarPartidaActual(nombreSlot: String) boolean\n        + cargarPartidaExistente(nombreSlot: String) boolean\n        + nuevaPartida(nombreJugador: String) void\n    }\n\n    %% HERENCIA\n    EntidadCombate &lt;|-- Personaje\n    EntidadCombate &lt;|-- Enemigo\n\n    Personaje &lt;|-- Guerrero\n    Personaje &lt;|-- Hechicero\n    Personaje &lt;|-- Asesino\n\n    Guerrero &lt;|-- Tanque\n    Guerrero &lt;|-- Berserker\n\n    Hechicero &lt;|-- Mago\n    Hechicero &lt;|-- Sacerdote\n\n    Asesino &lt;|-- Arquero\n    Asesino &lt;|-- Picaro\n\n    Enemigo &lt;|-- Jefe\n    Enemigo &lt;|-- Elite\n    Enemigo &lt;|-- Estandar\n    Enemigo &lt;|-- Minion\n\n    Item &lt;|-- ItemEquipable\n    Item &lt;|-- ItemConsumible\n\n    ItemConsumible &lt;|-- PocionVida\n    PocionVida &lt;|-- PocionVidaChica\n    PocionVida &lt;|-- PocionVidaMediana\n    PocionVida &lt;|-- PocionVidaGrande\n\n    ItemConsumible &lt;|-- PocionMana\n    PocionMana &lt;|-- PocionManaChica\n    PocionMana &lt;|-- PocionManaMediana\n    PocionMana &lt;|-- PocionManaGrande\n\n    %% RELACIONES / ASOCIACIONES\n    Jugador \&quot;1\&quot; *-- \&quot;1\&quot; Inventario : inventarioGlobal (Creator)\n    Jugador \&quot;1\&quot; *-- \&quot;2..4\&quot; Personaje : party\n    Inventario \&quot;1\&quot; o-- \&quot;*\&quot; Item : almacena\n    \n    Personaje \&quot;1\&quot; o-- \&quot;0..1\&quot; ItemEquipable : armaEquipada\n    Personaje \&quot;1\&quot; o-- \&quot;0..1\&quot; ItemEquipable : armaduraEquipada\n\n    GestorPartida \&quot;1\&quot; o-- \&quot;1\&quot; Jugador : administra\n    GestorPartida \&quot;1\&quot; o-- \&quot;0..1\&quot; BatallaController : orquesta (Controller)\n    GestorPartida ..&gt; GestorArchivos : utiliza\n\n    BatallaController \&quot;1\&quot; o-- \&quot;*\&quot; Personaje : gestiona turnos\n    BatallaController \&quot;1\&quot; o-- \&quot;*\&quot; Enemigo : gestiona turnos&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="5gmjIE1j6I006ReLBtGb-410">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry height="1328" width="864" as="geometry" />
          </mxCell>
        </UserObject>
